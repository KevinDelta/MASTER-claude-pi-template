# Project environment — copy to .pi/.env and fill in values.
# .pi/.env is gitignored — never commit it.

# Project namespace for domain memory tagging.
# Use a short slug: "client-acme", "content-q2", "infra-2026"
# Observations captured by memory-db.ts are tagged with this value.
PI_PROJECT_ID=my-project-slug

# Active workspace name — matches the folder under workspaces/
# Used by memory-db.ts to tag observations with workspace context, enabling per-workspace recall.
# Update this when switching focus between workspaces in the same project.
# PI_WORKSPACE=research

# Current project phase — e.g. discovery, delivery, review, maintenance
# Extensions can use this to adjust behavior per phase (e.g. deeper memory injection during delivery,
# lighter injection during maintenance). No built-in enforcement — wired up in memory-db.ts conditionals.
# PI_PHASE=delivery
