# agentmemory bridge extension configuration
# Copy this file to .pi/.env and fill in values for your project.
# .pi/.env is gitignored — never commit it.

# agentmemory service URL (default: http://localhost:3111)
# Change if running on a different port or remote host.
AGENTMEMORY_URL=http://localhost:3111

# Project namespace for memory isolation across projects.
# Use a short slug: "client-acme", "content-q2", "infra-2026"
# Each project gets its own isolated memory space.
AGENTMEMORY_PROJECT_ID=my-project

# Token budget for semantic recall injection per turn (default: 2000)
# Increase for complex long-running engagements where broad recall pays off.
# Decrease if context is tight or tasks are narrow / well-scoped.
AGENTMEMORY_TOKEN_BUDGET=2000

# Auto-capture tool calls as episodic observations (default: true)
# When true, every write/edit/bash call is recorded as working memory.
# Set to false if you want semantic search available but not auto-observation.
AGENTMEMORY_AUTO_CAPTURE=true

# Enable Claude Bridge sync to MEMORY.md at session end (default: false)
# When true, agentmemory consolidates memories and writes them back to
# memory/MEMORY.md — keeping the git-committed record current.
# Recommended for engagements longer than a week.
CLAUDE_BRIDGE_SYNC=true
