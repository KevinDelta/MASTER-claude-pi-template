# Domain environment - copy to ~/.openclaw/workspaces/<domain-name>/.env
# Never commit a filled .env file.

OPENCLAW_DOMAIN_NAME=my-domain
DOMAIN_MEMORY_DB_PATH=~/.openclaw/workspaces/my-domain/memory.db
DOMAIN_MEMORY_PATH=~/.openclaw/workspaces/my-domain/MEMORY.md
DOMAIN_MEMORY_TOP_N=10
OLLAMA_URL=http://localhost:11434

# Gateway auth token for ~/.openclaw/openclaw.json.
# Generate: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Per-project values can override these when a project route invokes the agent.
PROJECT_ID=
PROJECT_WORKSPACE=
PROJECT_PHASE=
