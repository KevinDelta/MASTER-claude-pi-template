# Domain environment - lives at ~/.openclaw/workspace/.env
# Never commit a filled .env file.

OPENCLAW_DOMAIN_NAME=my-domain
DOMAIN_MEMORY_DB_PATH=~/.openclaw/workspace/memory.db
DOMAIN_MEMORY_PATH=~/.openclaw/workspace/MEMORY.md
DOMAIN_MEMORY_TOP_N=10
OLLAMA_URL=http://localhost:11434

# Optional Stripe commerce plugin. Prefer restricted API keys (`rk_*`).
# Keep live broad secret keys (`sk_live_*`) out of agent tooling.
DOMAIN_COMMERCE_STRIPE_KEY_ENV=STRIPE_RESTRICTED_KEY
STRIPE_RESTRICTED_KEY=
STRIPE_API_VERSION=2026-02-25.clover
DOMAIN_COMMERCE_CATALOG_PATH=~/.openclaw/workspace/commerce-catalog.json
DOMAIN_COMMERCE_ALLOW_PAYMENT_LINKS_WITHOUT_APPROVAL=false
DOMAIN_COMMERCE_MAX_AUTO_APPROVED_AMOUNT_CENTS=0

# Gateway auth token for ~/.openclaw/openclaw.json.
# Generate: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Per-project values can override these when a project route invokes the agent.
PROJECT_ID=
PROJECT_WORKSPACE=
PROJECT_PHASE=
