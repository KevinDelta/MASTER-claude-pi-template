{
  // Reference template for ~/.openclaw/openclaw.json.
  // install.sh uses OpenClaw CLI commands where possible and copies this file
  // into the domain workspace as documentation for the installed agent.
  //
  // Path scheme (see ADR 0004):
  //   ~/.openclaw/workspace/        — template-owned workspace content
  //   ~/.openclaw/plugins/<plugin>  — plugin source, slug-suffixed for future
  //                                   multi-domain support
  //   ~/.openclaw/agents/<name>/    — OpenClaw's per-agent state; NEVER ours
  logging: { level: "info" },

  gateway: {
    port: 18789,
    bind: "loopback",
    auth: {
      token: "${OPENCLAW_GATEWAY_TOKEN}",
    },
    reload: { mode: "hybrid" },
  },

  session: {
    dmScope: "per-channel-peer",
    reset: {
      mode: "daily",
      atHour: 4,
      idleMinutes: 120,
    },
  },

  agents: {
    defaults: {
      workspace: "~/.openclaw/workspace",
      model: {
        primary: "anthropic/claude-sonnet-4-5",
        fallbacks: ["openai/gpt-5.2"],
      },
      thinkingDefault: "medium",
      timeoutSeconds: 1800,
      heartbeat: {
        every: "30m",
        target: "last",
        lightContext: false,
        isolatedSession: true,
        prompt: "Read HEARTBEAT.md if it exists. OpenClaw includes only due tasks from its native tasks block; follow those task prompts strictly. Resolve every recurring task through the AGENTS.md routing table before acting. If nothing needs attention, reply HEARTBEAT_OK.",
        ackMaxChars: 300,
      },
    },
    list: [
      {
        id: "main",
        default: true,
        workspace: "~/.openclaw/workspace",
        heartbeat: {
          every: "30m",
          target: "last",
        },
      },
    ],
  },

  skills: {
    // Last-wins precedence: plugin-core < plugin-domain < vendor < user.
    // Routing rows decide what loads; the agent does not browse list_skills to pick skills.
    load: {
      extraDirs: [
        "~/.openclaw/plugins/domain-skills-{{DOMAIN_NAME}}/core",
        "~/.openclaw/plugins/domain-skills-{{DOMAIN_NAME}}/domains/{{DOMAIN_NAME}}",
        "~/.openclaw/workspace/skills/vendor",
        "~/.openclaw/workspace/skills",
      ],
    },
  },

  plugins: {
    enabled: true,
    load: {
      paths: [
        "~/.openclaw/plugins/domain-memory-{{DOMAIN_NAME}}",
        "~/.openclaw/plugins/domain-skills-{{DOMAIN_NAME}}",
        // Optional, installed with install.sh --enable-commerce:
        // "~/.openclaw/plugins/domain-commerce-{{DOMAIN_NAME}}",
      ],
    },
    entries: {
      "domain-memory": {
        enabled: true,
        config: {
          domainName: "{{DOMAIN_NAME}}",
          dbPath: "~/.openclaw/workspace/memory.db",
          memoryPath: "~/.openclaw/workspace/MEMORY.md",
          ollamaUrl: "http://localhost:11434",
          memoryTopN: 10,
        },
      },
      "domain-skills": {
        enabled: true,
        config: {
          domainName: "{{DOMAIN_NAME}}",
          pluginRoot: "~/.openclaw/plugins/domain-skills-{{DOMAIN_NAME}}",
          vendorDir: "~/.openclaw/workspace/skills/vendor",
          userDir: "~/.openclaw/workspace/skills",
        },
      },
      // Optional Stripe workflow plugin. Use restricted Stripe keys (`rk_*`),
      // keep live broad secret keys out of agent tools, and preserve the
      // approval gates declared in DOCK.md.
      // "domain-commerce": {
      //   enabled: true,
      //   config: {
      //     domainName: "{{DOMAIN_NAME}}",
      //     stripeApiKeyEnv: "STRIPE_RESTRICTED_KEY",
      //     stripeApiVersion: "2026-02-25.clover",
      //     catalogPath: "~/.openclaw/workspace/commerce-catalog.json",
      //     allowPaymentLinksWithoutApproval: false,
      //     maxAutoApprovedAmountCents: 0,
      //   },
      // },
    },
  },

  channels: {
    // OpenClaw native routing belongs here: channel/account/peer bindings decide
    // which agent receives a message. Do not encode those bindings in AGENTS.md;
    // AGENTS.md starts after this routing step and decides how work is performed.
    //
    // Configure channel allowlists explicitly before enabling remote access.
    // Example:
    // telegram: {
    //   enabled: true,
    //   botToken: "${TELEGRAM_BOT_TOKEN}",
    //   dmPolicy: "allowlist",
    //   allowFrom: ["tg:123456789"],
    // },
  },
}
