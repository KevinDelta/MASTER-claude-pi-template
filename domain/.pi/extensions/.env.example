# memory-db extension configuration
# Copy to ~/.pi/domain/<domain-name>/.pi/.env and fill in.
# Domain-level — applies across all projects unless overridden per project.
#
# SETUP:
# 1. cp .env.example .env
# 2. Set PI_DOMAIN_NAME to your domain directory name
# 3. Set PI_PROJECT_ID per project in <project-root>/.pi/.env
# 4. Ensure ollama is running: ollama serve
# 5. Ensure nomic-embed-text is pulled: ollama pull nomic-embed-text

# Domain name (required — set by install.sh, matches ~/.pi/domain/<name>/ directory)
PI_DOMAIN_NAME=my-domain

# Absolute path to memory.db (default: ~/.pi/domain/<PI_DOMAIN_NAME>/memory.db)
# Override only if you want a non-standard DB path.
# PI_DOMAIN_DB_PATH=

# Project identifier — set per project in <project-root>/.pi/.env
# Observations are tagged by this ID so you can filter by project in DB queries.
# PI_PROJECT_ID=my-project-slug

# Token budget for memory injection per turn (default: 16000)
# Rough estimate: 1 token ≈ 4 characters. This controls the char budget for injected context.
PI_MEMORY_TOKEN_BUDGET=16000

# Number of observations to retrieve per search type (FTS + vector combined, default: 10)
PI_MEMORY_TOP_N=10

# Ollama endpoint for nomic-embed-text embeddings (default: http://localhost:11434)
# Change if ollama runs on a non-default port or remote host.
OLLAMA_URL=http://localhost:11434

# Append a session summary comment to MEMORY.md at agent_end (default: false)
# When true, appends a one-line comment: "session <timestamp> — N observations captured"
# Useful for tracking activity without cluttering MEMORY.md.
PI_MEMORY_SYNC_MD=false

# Auto-capture tool calls as observations (default: true)
# When false, only manual insertions appear in observations. Disabling reduces DB growth.
PI_MEMORY_AUTO_CAPTURE=true
